@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockListItem>
@{
    var bgMedia = Model.Content.GetProperty("bodenplanBild")?.GetValue() as Umbraco.Cms.Core.Models.PublishedContent.IPublishedContent;
    var bgUrl = bgMedia?.GetCropUrl();
    var lineColor = Model.Content.Value<string>("linienFarbe");

    var query = new List<string>();
    if (!string.IsNullOrWhiteSpace(bgUrl)) query.Add("bg=" + Uri.EscapeDataString(bgUrl));
    if (!string.IsNullOrWhiteSpace(lineColor)) query.Add("line=" + Uri.EscapeDataString(lineColor));
    var iframeSrc = "/passivmitglieder/hallenboden" + (query.Count > 0 ? "?" + string.Join("&", query) : "");
}
<section class="pme-section">
  <div class="pme-container">
    <iframe src="@iframeSrc"
            class="pme-iframe"
            title="Hallenboden Passivmitgliedschaft"></iframe>
    <script>
      (function () {
        var frame = document.currentScript.previousElementSibling;
        if (!frame || frame.tagName !== 'IFRAME') return;
        window.addEventListener('message', function (e) {
          if (e.source !== frame.contentWindow) return;
          var d = e.data || {};
          if (d.type === 'pm-height' && typeof d.height === 'number' && d.height > 0) {
            frame.style.height = d.height + 'px';
          } else if (d.type === 'pm-expand') {
            frame.classList.toggle('is-expanded', !!d.expanded);
          }
        });
      })();
    </script>
  </div>
</section>
