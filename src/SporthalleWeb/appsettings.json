{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "Id": "f3d2219e-ee89-44ae-b54c-74f8db53eb99"
      },
      "ModelsBuilder": {
        "ModelsMode": "Nothing"
      },
      "Content": {
        "AllowEditInvariantFromNonDefault": true,
        "ContentVersionCleanupPolicy": {
          "EnableCleanup": true
        },
        "LoginBackgroundImage": "/img/login-bg.jpg"
      },
      "Unattended": {
        "UpgradeUnattended": true
      },
      "Security": {
        "AllowConcurrentLogins": false
      },
      "Media": {
        "AllowedUploadedFileExtensions": "jpeg,jpg,gif,png,svg,webp,pdf,mp4"
      }
    },
    "Storage": {
      "AzureBlob": {
        "Media": {
          "ConnectionString": "",
          "ContainerName": "media"
        }
      }
    }
  },
  "ConnectionStrings": {
    "umbracoDbDSN": "",
    "umbracoDbDSN_ProviderName": "Microsoft.Data.SqlClient"
  },
  "uSync": {
    "Settings": {
      "ImportOnStartup": true,
      "ExportOnSave": true
    }
  },
  "BackOfficeAuth": {
    "TenantId": "",
    "ClientId": "",
    "ClientSecret": ""
  },
  "Graph": {
    "TenantId": "",
    "ClientId": "",
    "ClientSecret": "",
    "ClientSecretExpires": ""
  },
  "Email": {
    "Outbox": {
      "RetentionDays": 30
    }
  },
  "Turnstile": {
    "SiteKey": "",
    "SecretKey": ""
  },
  "Gluecksspiel": {
    "Secret": ""
  }
}