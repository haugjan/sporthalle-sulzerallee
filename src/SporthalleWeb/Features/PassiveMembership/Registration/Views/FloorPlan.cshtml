@using SporthalleWeb.Features.PassiveMembership.Registration
@model (string SiteKey, bool ViewOnly)
@{
    Layout = null;
    var siteKey = Model.SiteKey ?? "1x00000000000000000000AA";
    var viewOnly = Model.ViewOnly;
}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>Hallenboden</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;900&family=Manrope:wght@400;600;700&display=swap" rel="stylesheet">
    <style>html, body { margin: 0; padding: 0; font-family: "Manrope", sans-serif; }</style>
    @if (viewOnly)
    {
    <style>
        html, body { height: 100%; overflow: hidden; background: #111; }
        .pm-floor-section {
            height: 100vh !important;
            margin: 0 !important;
            padding: 0 !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
        }
        .pm-counter { display: none !important; }
        #pm-svg-container {
            display: inline-block !important;
            position: relative !important;
            max-width: 100% !important;
            max-height: 100vh !important;
            line-height: 0;
        }
        #pm-floor-img {
            max-width: 100% !important;
            max-height: 100vh !important;
            width: auto !important;
            height: auto !important;
        }
    </style>
    }
</head>
<body>
    <component type="typeof(FloorPlanComponent)" render-mode="ServerPrerendered"
               param-TurnstileSiteKey="@siteKey" param-ViewOnly="@viewOnly" />
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    <script src="/_framework/blazor.server.js" autostart="false"></script>
    <script>Blazor.start({ reconnectionOptions: { maxRetries: 10, retryIntervalMilliseconds: 3000 } });</script>
    <script>
        var _pmTurnstileToken = null;
        var _pmWidgetId = null;
        window.pmInitTurnstile = function(siteKey, containerId) {
            _pmTurnstileToken = null;
            if (!window.turnstile) return;
            if (_pmWidgetId) {
                // Widget already exists — reset it to get a fresh token via the original callback.
                window.turnstile.reset(_pmWidgetId);
                return;
            }
            var container = document.getElementById(containerId);
            if (!container) return;
            _pmWidgetId = window.turnstile.render('#' + containerId, {
                sitekey: siteKey,
                callback: function(token) { _pmTurnstileToken = token; }
            });
        };
        window.pmClearTurnstile = function() {
            if (_pmWidgetId !== null && window.turnstile) {
                window.turnstile.remove(_pmWidgetId);
            }
            _pmTurnstileToken = null;
            _pmWidgetId = null;
        };
        window.pmGetTurnstileToken = function() { return _pmTurnstileToken; };
        window.pmNotifyExpand = function(expanded) {
            window.parent.postMessage({ type: 'pm-expand', expanded: !!expanded }, '*');
        };
        // Send the whole browser (top window, not just this iframe) to the payment page
        // after a successful registration. Falls back to the iframe if the top window
        // is not reachable (e.g. cross-origin embedding).
        window.pmRedirectToPayment = function(url) {
            try { window.top.location.href = url; }
            catch (e) { window.location.href = url; }
        };

        // Report content height to the parent so the embedding iframe can size itself
        // exactly to the floor plan (avoids a large empty gap below the tool).
        (function () {
            var lastHeight = 0;
            function postHeight() {
                var h = Math.ceil(document.documentElement.scrollHeight);
                if (h > 0 && h !== lastHeight) {
                    lastHeight = h;
                    window.parent.postMessage({ type: 'pm-height', height: h }, '*');
                }
            }
            window.addEventListener('load', postHeight);
            window.addEventListener('resize', postHeight);
            if (window.ResizeObserver) {
                new ResizeObserver(postHeight).observe(document.body);
            }
            // Fallbacks: Blazor prerender hydration and floor-plan image load can
            // change the height shortly after the initial paint.
            setTimeout(postHeight, 300);
            setTimeout(postHeight, 1200);
        })();
    </script>
</body>
</html>
